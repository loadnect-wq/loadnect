<?xml version="1.0" encoding="utf-8"?>
<!--
  Root paints brand maroon: with edge-to-edge on Android 15+, the padded
  status-bar strip renders in this colour, so the system UI reads as Hallnect
  chrome. Content area sits on ivory.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/maroon_700">

    <!-- Pull-to-refresh wrapping the WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ivory" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Slim gold page-load indicator along the top edge -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone"
        app:indicatorColor="@color/gold"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />

    <!-- Branded offline screen; replaces raw WebView error pages -->
    <LinearLayout
        android:id="@+id/offlineView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/maroon_700"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/offline_title"
            android:textColor="@color/ivory"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/offline_body"
            android:textColor="@color/ivory_dim"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="180dp"
            android:paddingVertical="12dp"
            android:text="@string/try_again"
            android:textColor="@color/maroon_900"
            android:textStyle="bold"
            app:backgroundTint="@color/gold"
            app:cornerRadius="14dp" />
    </LinearLayout>
</FrameLayout>
