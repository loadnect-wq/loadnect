# ─────────────────────────────────────────────────────────────────────────────
# Hallnect — Environment Variable Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Public — safe to expose to the browser.
#
# ⚠️  MUST include the scheme (https://). A scheme-less value like
#     "www.hallnect.com" is NOT an absolute URL: third parties (Supabase
#     auth, Cashfree) resolve it against THEIR OWN origin, producing broken
#     redirects such as https://<project>.supabase.co/www.hallnect.com/?code=…
#     lib/env.ts#getAppUrl() now repairs a missing scheme defensively, but set it
#     correctly here and in Vercel.
#
#     Production: NEXT_PUBLIC_APP_URL=https://www.hallnect.com
#     Local dev:  NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional explicit override of the public origin — WINS over NEXT_PUBLIC_APP_URL
# when set. The resolver (lib/app-url.ts) also ignores retired hosts (the old
# hallnect5.vercel.app alias) and falls back to https://www.hallnect.com in
# production, so a stale variable can no longer break OAuth or payment returns.
# NEXT_PUBLIC_SITE_URL=https://www.hallnect.com
#
# NOTE: auth redirects do NOT read this variable — signup/login/OAuth use
# window.location.origin, and /auth/callback uses the request origin. The
# Supabase Site URL + Redirect allow-list are configured in the Supabase
# dashboard (see docs/AUTH_PRODUCTION_URL_FIX.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hallnect

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Public — safe to expose to the browser (used by the anon/browser client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ⛔ SECRET — NEVER expose to the browser or commit to version control.
# Used only by lib/supabase/admin.ts (server-only, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── Authentication ────────────────────────────────────────────────────────────
# Auth is handled by Supabase Auth — no separate NextAuth secret needed.
# OAuth provider redirect URLs are configured in the Supabase Dashboard.

# ── Commission workflow (optional) ────────────────────────────────────────────
# Hallnect's UPI ID for owners paying outstanding commission manually. This is a
# convenience default only — the authoritative value is admin-editable in
# Admin → Settings (platform_settings.hallnect_upi_id). Safe to leave blank.
HALLNECT_UPI_ID=

# ⛔ SECRET — server-only. Shared secret that lets a scheduled job (e.g. Vercel
# Cron) call POST /api/admin/commissions/run-overdue-check without an admin
# session, via header `Authorization: Bearer <CRON_SECRET>`. If unset, only a
# logged-in admin can trigger the overdue check. See docs/SCHEDULED_JOBS.md.
CRON_SECRET=

# ── File / Image Storage ──────────────────────────────────────────────────────
# Image uploads will use Supabase Storage (configured in a later step).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Payment Gateway (Cashfree) ────────────────────────────────────────────────
# Find these in: Cashfree Dashboard → Developers → API Keys.
# Use the SANDBOX (test) credentials first, then switch to production later.
#
# ⛔ SECRET — server-only. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' (test) or 'production' (live). Controls which Cashfree API host
# the SERVER calls.
CASHFREE_ENV=sandbox
# Public mirror of the env — the browser SDK needs to know which mode to open
# checkout in. Safe to expose (it's just 'sandbox' / 'production', not a key).
NEXT_PUBLIC_CASHFREE_ENV=sandbox
# ⛔ SECRET — server-only. Optional dedicated secret for verifying webhook
# signatures. If unset, the webhook falls back to CASHFREE_SECRET_KEY (Cashfree
# signs webhooks with the client secret by default). Set this to rotate the
# webhook secret independently of the API key.
CASHFREE_WEBHOOK_SECRET=

# ── Cashfree Easy Split (marketplace vendor settlement) ───────────────────────
# Feature flag for the paise settlement engine's LIVE vendor-split dispatch.
# Leave 'false' (or unset) until Easy Split is enabled on your Cashfree account
# and hall owners have a verified cashfree_vendor_id. When false, the engine
# records the intended split in the ledger but does NOT move vendor money.
# See docs/CASHFREE_EASY_SPLIT_ENGINE.md.
CASHFREE_EASY_SPLIT_ENABLED=false

# ── Twilio: shared credentials ────────────────────────────────────────────────
# Both the WhatsApp notification channel and the phone-OTP feature authenticate
# with these. Find them at: Twilio Console → Account SID / Auth Token.
#
# ⛔ BOTH ARE SECRETS — server-only, never NEXT_PUBLIC_, never committed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Twilio WhatsApp (booking / payment / moderation notifications) ────────────
# WhatsApp is the ONLY channel this platform sends on. There is no SMS path and
# no SMS fallback anywhere in the code.
#
# The ENTIRE pipeline is built and DORMANT until these are set. With
# TWILIO_WHATSAPP_ENABLED=false (the default) every message is recorded in the
# `notifications` table with status 'skipped' and a precise reason, and the app
# works normally — nothing throws, nothing pretends to have sent.
#
# TO GO LIVE, all four must be true:
#   1. TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN set (above)
#   2. a sender set — TWILIO_WHATSAPP_FROM (your linked WhatsApp number) or
#      TWILIO_MESSAGING_SERVICE_SID
#   3. the Content SIDs below filled in for templates Meta has APPROVED
#   4. TWILIO_WHATSAPP_ENABLED=true
TWILIO_WHATSAPP_ENABLED=false

# Your WhatsApp sender, in E.164. The "whatsapp:" prefix is added in code, so
# either "+14155238886" or "whatsapp:+14155238886" works.
TWILIO_WHATSAPP_FROM=

# Alternative to TWILIO_WHATSAPP_FROM: send through a Messaging Service that
# has the WhatsApp sender attached. If both are set, the Messaging Service wins.
TWILIO_MESSAGING_SERVICE_SID=

# TEST MODE: redirect EVERY message to one number instead of the real
# recipient, so a staging deploy pointed at production data cannot message real
# customers. Requires BOTH values — a test mode with nowhere to send would
# silently drop everything, so it stays off unless TEST_TO is also set.
# Messages sent this way are flagged "TEST" in the admin dashboard.
TWILIO_WHATSAPP_TEST_MODE=false
TWILIO_WHATSAPP_TEST_TO=

# ── WhatsApp Content Templates ────────────────────────────────────────────────
# A business-initiated WhatsApp message MUST use a Meta-approved template. Since
# 1 April 2025 sending the text in `Body` instead fails with Twilio error 63016.
#
# Create each template in Twilio Console → Content Template Builder, submit it
# for WhatsApp approval, and paste the resulting Content SID (HX + 32 hex chars)
# here. The exact body text to submit for each one is in
# docs/WHATSAPP_TEMPLATES.md — generated from the same code that renders the
# real messages, so the approved template and what we send cannot drift apart.
#
# Any template left blank is NOT a failure: messages needing it are recorded as
# 'skipped' with the reason, and the admin dashboard lists exactly which ones
# are missing. Fill them in as approvals come through.
#
# ⚠️ These are NOT secrets — a Content SID identifies approved public message
#    copy, not a credential. They are configuration.

# Customer
TWILIO_TEMPLATE_CUSTOMER_BOOKING_CREATED=
TWILIO_TEMPLATE_CUSTOMER_BOOKING_CONFIRMED=
TWILIO_TEMPLATE_CUSTOMER_BOOKING_CANCELLED=
TWILIO_TEMPLATE_CUSTOMER_PAYMENT_SUCCESS=
TWILIO_TEMPLATE_CUSTOMER_PAYMENT_FAILED=
TWILIO_TEMPLATE_CUSTOMER_REFUND_INITIATED=

# Owner
TWILIO_TEMPLATE_OWNER_NEW_BOOKING=
TWILIO_TEMPLATE_OWNER_BOOKING_CANCELLED=
TWILIO_TEMPLATE_OWNER_PAYMENT_RECEIVED=
TWILIO_TEMPLATE_OWNER_HALL_SUBMITTED=
TWILIO_TEMPLATE_OWNER_HALL_APPROVED=
TWILIO_TEMPLATE_OWNER_HALL_REJECTED=
TWILIO_TEMPLATE_OWNER_ACCOUNT_UPDATE=

# Admin (one operational template covers every admin alert)
TWILIO_TEMPLATE_ADMIN_ALERT=

# ── Admin alert number ────────────────────────────────────────────────────────
# Where platform alerts go (new bookings, payments, hall submissions, failures).
#
# Resolution order: platform_settings.admin_whatsapp_phone (editable in the
# admin dashboard, no redeploy) → this variable → CONTACT.phone in
# lib/constants.ts. Any common format works — it is normalized to E.164 before
# sending. Must be a number that has WhatsApp installed.
ADMIN_WHATSAPP_NUMBER=

# ── Twilio Verify (phone OTP) ─────────────────────────────────────────────────
# Optional. Confirms a user owns the number they entered, so a verified number
# outranks the client-supplied booking contact number when we message them.
# Dormant until set: /verify-phone shows "not configured yet" and there is NO
# mock/bypass OTP in any environment.
#
# Create a Verify Service at: Twilio Console → Verify → Services.
TWILIO_VERIFY_SERVICE_SID=

# Channel the OTP is delivered on. Defaults to whatsapp, matching the rest of
# the platform. Set to "sms" ONLY if your Verify Service does not have WhatsApp
# enabled — it is a deliberate choice, not an automatic fallback.
TWILIO_VERIFY_CHANNEL=whatsapp

# ── Email ─────────────────────────────────────────────────────────────────────
# ⛔ SECRET — server-only.
# RESEND_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
# SENTRY_DSN=
