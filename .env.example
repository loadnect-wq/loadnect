# ─────────────────────────────────────────────────────────────────────────────
# Hallnect — Environment Variable Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Public — safe to expose to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hallnect

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Public — safe to expose to the browser (used by the anon/browser client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ⛔ SECRET — NEVER expose to the browser or commit to version control.
# Used only by lib/supabase/admin.ts (server-only, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── Authentication ────────────────────────────────────────────────────────────
# Auth is handled by Supabase Auth — no separate NextAuth secret needed.
# OAuth provider redirect URLs are configured in the Supabase Dashboard.

# ── File / Image Storage ──────────────────────────────────────────────────────
# Image uploads will use Supabase Storage (configured in a later step).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Payment Gateway (Cashfree) ────────────────────────────────────────────────
# Find these in: Cashfree Dashboard → Developers → API Keys.
# Use the SANDBOX (test) credentials first, then switch to production later.
#
# ⛔ SECRET — server-only. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' (test) or 'production' (live). Controls which Cashfree API host
# the SERVER calls.
CASHFREE_ENV=sandbox
# Public mirror of the env — the browser SDK needs to know which mode to open
# checkout in. Safe to expose (it's just 'sandbox' / 'production', not a key).
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# ── Email ─────────────────────────────────────────────────────────────────────
# ⛔ SECRET — server-only.
# RESEND_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
# SENTRY_DSN=
