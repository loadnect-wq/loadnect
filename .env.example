# ─────────────────────────────────────────────────────────────────────────────
# Hallnect — Environment Variable Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Public — safe to expose to the browser.
#
# THE PRODUCTION ORIGIN IS https://hallnect.com  (apex, no www).
# www.hallnect.com 301s to it and is therefore NOT the serving host. Both it
# and the released hallnect5.vercel.app alias are on the RETIRED_HOSTS list in
# lib/app-url.ts: a variable pointing at either is IGNORED, because a canonical,
# an OAuth redirect_to or a Cashfree return_url aimed at a redirect is a bug.
#
# ⚠️  MUST include the scheme (https://). A scheme-less value like
#     "hallnect.com" is NOT an absolute URL: third parties (Supabase auth,
#     Cashfree) resolve it against THEIR OWN origin, producing broken redirects
#     such as https://<project>.supabase.co/hallnect.com/?code=…
#     lib/app-url.ts repairs a missing scheme defensively, but set it correctly
#     here and in Vercel.
#
#     Production: NEXT_PUBLIC_APP_URL=https://hallnect.com
#     Local dev:  NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional explicit override of the public origin — WINS over NEXT_PUBLIC_APP_URL
# when set, but is filtered through the same retired-host guard, so neither
# variable can route auth or payment returns at a dead or redirecting domain.
# NEXT_PUBLIC_SITE_URL=https://hallnect.com
#
# NOTE: OAuth return URLs are built from this same resolver
# (buildAuthCallbackUrl in lib/app-url.ts), NOT from window.location.origin —
# a customer who arrives on a protected preview URL must still be sent back to
# the public origin. The Supabase Site URL + Redirect allow-list are configured
# in the Supabase dashboard (see docs/AUTH_PRODUCTION_URL_FIX.md) and must
# contain https://hallnect.com/auth/callback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hallnect

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Public — safe to expose to the browser (used by the anon/browser client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ⛔ SECRET — NEVER expose to the browser or commit to version control.
# Used only by lib/supabase/admin.ts (server-only, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── Authentication ────────────────────────────────────────────────────────────
# Auth is handled by Supabase Auth — no separate NextAuth secret needed.
# OAuth provider redirect URLs are configured in the Supabase Dashboard.

# ── Commission workflow (optional) ────────────────────────────────────────────
# Hallnect's UPI ID for owners paying outstanding commission manually. This is a
# convenience default only — the authoritative value is admin-editable in
# Admin → Settings (platform_settings.hallnect_upi_id). Safe to leave blank.
HALLNECT_UPI_ID=

# ⛔ SECRET — server-only. Shared secret that lets a scheduled job (e.g. Vercel
# Cron) call POST /api/admin/commissions/run-overdue-check without an admin
# session, via header `Authorization: Bearer <CRON_SECRET>`. If unset, only a
# logged-in admin can trigger the overdue check. See docs/SCHEDULED_JOBS.md.
CRON_SECRET=

# ── File / Image Storage ──────────────────────────────────────────────────────
# Image uploads will use Supabase Storage (configured in a later step).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Payment Gateway (Cashfree) ────────────────────────────────────────────────
# Find these in: Cashfree Dashboard → Developers → API Keys.
# Use the SANDBOX (test) credentials first, then switch to production later.
#
# ⛔ SECRET — server-only. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' (test) or 'production' (live). Controls which Cashfree API host
# the SERVER calls.
CASHFREE_ENV=sandbox
# Public mirror of the env — the browser SDK needs to know which mode to open
# checkout in. Safe to expose (it's just 'sandbox' / 'production', not a key).
NEXT_PUBLIC_CASHFREE_ENV=sandbox
# ⛔ SECRET — server-only. Optional dedicated secret for verifying webhook
# signatures. If unset, the webhook falls back to CASHFREE_SECRET_KEY (Cashfree
# signs webhooks with the client secret by default). Set this to rotate the
# webhook secret independently of the API key.
CASHFREE_WEBHOOK_SECRET=

# ── Cashfree PAYOUTS (how a venue owner actually gets paid) ───────────────────
# A SEPARATE PRODUCT FROM THE GATEWAY, WITH ITS OWN CREDENTIALS. Cashfree issues
# one client id/secret pair per product, so the CASHFREE_APP_ID above will NOT
# authenticate here — generate a Payouts pair in the Cashfree dashboard under
# Developers > API Keys. An account without Payouts switched on answers HTTP 403
# `apis_not_enabled`, which looks exactly like a wrong-credentials error.
#
# Production may also require this server's IP to be allowlisted in the Cashfree
# dashboard. A 403 with correct keys is usually that.
#
# The mode follows CASHFREE_ENV, so the gateway and payouts can never be pointed
# at different environments by accident. Unset, payouts are simply unavailable
# and every transfer is a bank transfer made by hand from /admin/payments —
# nothing breaks, it just is not automatic. /admin/settings shows which.
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=

# 2FA PUBLIC KEY — required on Vercel, not optional in practice.
# Cashfree Payouts refuses any request whose source IP is not on the account's
# allowlist ("IP not whitelisted"). Vercel functions have NO fixed egress IP —
# static IPs are a Secure Compute/Enterprise feature — so an allowlist can never
# be satisfied from a Vercel deployment. Cashfree's alternative is a signature:
#   base64( RSA-OAEP( "<clientId>.<unix seconds>", publicKey ) )  as X-Cf-Signature
# Generate the key in the Cashfree dashboard: Payouts > Developers >
# Two-Factor Authentication > Public Key > Generate Public Key. Paste the PEM
# here (real newlines or 
 both work). Unset, the header is simply omitted and
# payouts fall back to IP-based auth, which will fail on Vercel.
CASHFREE_PAYOUT_PUBLIC_KEY=

# ── Cashfree Easy Split — SUPERSEDED by Payouts above ─────────────────────────
# Left documented only so an existing deployment knows to turn it OFF. Nothing
# reads this flag to move money any more. Setting it true while Easy Split is
# not enabled on the Cashfree account was strictly worse than leaving it false.
CASHFREE_EASY_SPLIT_ENABLED=false

# ── MSG91: SMS and OTP ────────────────────────────────────────────────────────
# MSG91 is the ONLY messaging provider. Both the notification channel and the
# phone-OTP feature authenticate with one account key. There is no second
# transport and no fallback anywhere in the code.
#
# Find it at: MSG91 panel -> AuthKey (viewing it requires an OTP to the account
# owner's registered mobile).
#
# BOTH ARE SECRETS - server-only, never NEXT_PUBLIC_, never committed.
MSG91_AUTH_KEY=

# ── The DLT sender header ─────────────────────────────────────────────────────
# Indian A2P SMS runs under TRAI's DLT regime. The header is 3-11 alphanumeric
# characters (6 is the norm for India, e.g. HLNECT) and must be REGISTERED on a
# telecom DLT portal against your Principal Entity, then added in
# MSG91 -> SMS -> Sender Id. A value that is not a valid header shape is treated
# as UNSET rather than sent, so a typo surfaces in the admin dashboard instead
# of as a rejected send in production.
MSG91_SENDER_ID=

# ── The master switch for outbound notification SMS ───────────────────────────
# The ENTIRE pipeline is built and DORMANT until this is true. While it is
# false (the default) every message is recorded in the `notifications` table
# with status 'skipped' and a precise reason, and the app works normally -
# nothing throws, nothing pretends to have sent.
#
# TO GO LIVE, all four must be true:
#   1. MSG91_AUTH_KEY set (above)
#   2. MSG91_SENDER_ID set to a DLT-approved header
#   3. the template ids below filled in for bodies approved on the DLT portal
#   4. MSG91_SMS_ENABLED=true
MSG91_SMS_ENABLED=false

# TEST MODE: redirect EVERY notification SMS to one number instead of the real
# recipient, so a staging deploy pointed at production data cannot message real
# customers. Requires BOTH values - a test mode with nowhere to send FAILS the
# send rather than falling through to the real recipient. Messages sent this way
# are flagged "TEST" in the admin dashboard.
#
# OTP is deliberately NOT redirected: an OTP proves control of the number it was
# sent to, so diverting it would verify the wrong phone.
MSG91_TEST_MODE=false
MSG91_TEST_TO=

# ── DLT-registered SMS templates ──────────────────────────────────────────────
# Every message body must be registered on a telecom DLT portal against the
# sender header above and approved by the operator. MSG91 then issues a
# template id (24 hex characters) for each one - paste those here.
#
# The exact body to register for each template is printed in the admin
# dashboard at /admin/notifications, generated from the same code that renders
# the real messages, so the approved template and what we send cannot drift
# apart. The operator matches on the text CHARACTER FOR CHARACTER.
#
# Any template left blank is NOT a failure: messages needing it are recorded as
# 'skipped' with the reason, and the dashboard lists exactly which are missing.
# Fill them in as approvals come through.
#
# These are NOT secrets - a template id identifies approved public message
# copy, not a credential. They are configuration.

# Customer
MSG91_TEMPLATE_CUSTOMER_BOOKING_CREATED=
MSG91_TEMPLATE_CUSTOMER_BOOKING_CONFIRMED=
MSG91_TEMPLATE_CUSTOMER_BOOKING_CANCELLED=
MSG91_TEMPLATE_CUSTOMER_PAYMENT_SUCCESS=
MSG91_TEMPLATE_CUSTOMER_PAYMENT_FAILED=
MSG91_TEMPLATE_CUSTOMER_REFUND_INITIATED=

# Owner
MSG91_TEMPLATE_OWNER_NEW_BOOKING=
MSG91_TEMPLATE_OWNER_BOOKING_CANCELLED=
MSG91_TEMPLATE_OWNER_PAYMENT_RECEIVED=
MSG91_TEMPLATE_OWNER_HALL_SUBMITTED=
MSG91_TEMPLATE_OWNER_HALL_LIVE=
MSG91_TEMPLATE_OWNER_HALL_REJECTED=
MSG91_TEMPLATE_OWNER_ACCOUNT_STATUS=
MSG91_TEMPLATE_OWNER_PAYMENT_RECEIPT=

# Admin (one operational template covers every admin alert)
MSG91_TEMPLATE_ADMIN_ALERT=

# ── Phone OTP ─────────────────────────────────────────────────────────────────
# Optional, and independent of MSG91_SMS_ENABLED. Confirms a user owns the
# number they entered, so a verified number outranks the client-supplied
# booking contact number when we message them.
#
# MSG91 generates, stores, expires and checks the code - this codebase never
# creates, stores or logs an OTP. Dormant until set: /verify-phone shows "not
# available yet" and there is NO mock/bypass OTP in any environment.
#
# Create the template at: MSG91 -> OTP -> SendOTP -> Templates. It needs the
# DLT template id of an approved OTP body, and a registered sender.
MSG91_OTP_TEMPLATE_ID=

# ── Delivery-report webhook ───────────────────────────────────────────────────
# MSG91 does NOT sign its callbacks, so a shared secret is the only control.
# Generate a long random value, put it here, and add it in the MSG91 panel at
# SMS -> Webhook -> Headers as:
#     x-hallnect-webhook-secret: <this value>
# pointing at https://hallnect.com/api/webhooks/msg91
#
# While this is unset the endpoint accepts NOTHING (503) rather than falling
# open - it writes to the notifications table, so an unauthenticated version
# would let anyone who guessed a request id mark a message "delivered".
#
# SECRET - server-only.
MSG91_WEBHOOK_SECRET=

# ── Admin alert number ────────────────────────────────────────────────────────
# Where platform alerts go (new bookings, payments, hall submissions, failures).
#
# Resolution order: platform_settings.admin_alert_phone (editable in the admin
# dashboard, no redeploy) -> this variable -> CONTACT.phone in lib/constants.ts.
# Any common format works - it is normalized to E.164 before sending.
#
# Any number works, INCLUDING one on the DND registry, provided the templates are
# registered under the Service Implicit category — that category is delivered
# 24x7 and reaches DND numbers. See docs/MSG91_SETUP.md.
ADMIN_ALERT_PHONE=

# ── Email ─────────────────────────────────────────────────────────────────────
# ⛔ SECRET — server-only.
# RESEND_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
# SENTRY_DSN=
