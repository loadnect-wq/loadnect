# ─────────────────────────────────────────────────────────────────────────────
# Hallnect — Environment Variable Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Public — safe to expose to the browser.
#
# ⚠️  MUST include the scheme (https://). A scheme-less value like
#     "hallnect5.vercel.app" is NOT an absolute URL: third parties (Supabase
#     auth, Cashfree) resolve it against THEIR OWN origin, producing broken
#     redirects such as https://<project>.supabase.co/hallnect5.vercel.app/?code=…
#     lib/env.ts#getAppUrl() now repairs a missing scheme defensively, but set it
#     correctly here and in Vercel.
#
#     Production: NEXT_PUBLIC_APP_URL=https://hallnect5.vercel.app
#     Local dev:  NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# NOTE: auth redirects do NOT read this variable — signup/login/OAuth use
# window.location.origin, and /auth/callback uses the request origin. The
# Supabase Site URL + Redirect allow-list are configured in the Supabase
# dashboard (see docs/AUTH_PRODUCTION_URL_FIX.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hallnect

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Public — safe to expose to the browser (used by the anon/browser client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ⛔ SECRET — NEVER expose to the browser or commit to version control.
# Used only by lib/supabase/admin.ts (server-only, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── Authentication ────────────────────────────────────────────────────────────
# Auth is handled by Supabase Auth — no separate NextAuth secret needed.
# OAuth provider redirect URLs are configured in the Supabase Dashboard.

# ── Commission workflow (optional) ────────────────────────────────────────────
# Hallnect's UPI ID for owners paying outstanding commission manually. This is a
# convenience default only — the authoritative value is admin-editable in
# Admin → Settings (platform_settings.hallnect_upi_id). Safe to leave blank.
HALLNECT_UPI_ID=

# ⛔ SECRET — server-only. Shared secret that lets a scheduled job (e.g. Vercel
# Cron) call POST /api/admin/commissions/run-overdue-check without an admin
# session, via header `Authorization: Bearer <CRON_SECRET>`. If unset, only a
# logged-in admin can trigger the overdue check. See docs/COMMISSION_CRON_SETUP.md.
CRON_SECRET=

# ── File / Image Storage ──────────────────────────────────────────────────────
# Image uploads will use Supabase Storage (configured in a later step).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Payment Gateway (Cashfree) ────────────────────────────────────────────────
# Find these in: Cashfree Dashboard → Developers → API Keys.
# Use the SANDBOX (test) credentials first, then switch to production later.
#
# ⛔ SECRET — server-only. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' (test) or 'production' (live). Controls which Cashfree API host
# the SERVER calls.
CASHFREE_ENV=sandbox
# Public mirror of the env — the browser SDK needs to know which mode to open
# checkout in. Safe to expose (it's just 'sandbox' / 'production', not a key).
NEXT_PUBLIC_CASHFREE_ENV=sandbox
# ⛔ SECRET — server-only. Optional dedicated secret for verifying webhook
# signatures. If unset, the webhook falls back to CASHFREE_SECRET_KEY (Cashfree
# signs webhooks with the client secret by default). Set this to rotate the
# webhook secret independently of the API key.
CASHFREE_WEBHOOK_SECRET=

# ── Cashfree Easy Split (marketplace vendor settlement) ───────────────────────
# Feature flag for the paise settlement engine's LIVE vendor-split dispatch.
# Leave 'false' (or unset) until Easy Split is enabled on your Cashfree account
# and hall owners have a verified cashfree_vendor_id. When false, the engine
# records the intended split in the ledger but does NOT move vendor money.
# See docs/CASHFREE_EASY_SPLIT_ENGINE.md.
CASHFREE_EASY_SPLIT_ENABLED=false

# ── Twilio Verify (phone OTP) ─────────────────────────────────────────────────
# The OTP architecture is fully built and DORMANT until these are set: without
# them the app runs normally and /verify-phone shows "not configured yet".
# There is NO mock/bypass OTP in any environment.
#
# Find these in: Twilio Console → Account SID/Auth Token, and create a Verify
# Service (Twilio Console → Verify → Services) for the Service SID.
#
# ⛔ ALL THREE ARE SECRETS — server-only, never NEXT_PUBLIC_, never committed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Twilio transactional SMS (booking/payment/moderation notifications) ─────
# The ENTIRE notification pipeline is built and DORMANT until these are set.
# With TWILIO_ENABLED=false (the default) every SMS is recorded in the
# `notifications` table with status 'skipped' and the app works normally —
# nothing throws, nothing pretends to have sent.
#
# To go live: set the credentials above (SID + auth token), then EITHER a
# Messaging Service SID (preferred — handles Indian DLT sender routing) OR a
# single from-number, then flip TWILIO_ENABLED=true and redeploy. That is the
# only switch — no code change needed.
# ⛔ TWILIO_MESSAGING_SERVICE_SID / TWILIO_PHONE_NUMBER are configuration, the
#    account SID + auth token above are SECRETS — server-only, never NEXT_PUBLIC_.
TWILIO_ENABLED=false
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Admin alert number for platform SMS (new bookings, new halls, failures).
# Optional: when empty, falls back to the official Hallnect contact number in
# lib/constants.ts (CONTACT.phone). Any common format works — it is normalized
# to E.164 (+91XXXXXXXXXX) before sending.
ADMIN_NOTIFICATION_PHONE=

# ── Email ─────────────────────────────────────────────────────────────────────
# ⛔ SECRET — server-only.
# RESEND_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
# SENTRY_DSN=
